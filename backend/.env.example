# Gemini (Google AI Studio — free tier) configuration
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash
# Optional — cheaper/faster model for background memory summarisation.
# Defaults to GEMINI_MODEL if unset.
GEMINI_SUMMARISE_MODEL=

# Optional — voice input (mic), via Hugging Face Inference API (free tier —
# sign in at huggingface.co, then create a token at
# https://huggingface.co/settings/tokens)
HF_API_TOKEN=
HF_TRANSCRIBE_MODEL=openai/whisper-large-v3
#
# Alternate transcription provider: Azure OpenAI (e.g. gpt-4o-mini-transcribe,
# whisper). Needs its own Azure resource/key — unrelated to Gemini above.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Supabase — chat history persistence (replaces local data/sessions.json).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_xxx_or_anon_key
# Optional — if set, used instead of SUPABASE_KEY (bypasses RLS, server-only).
SUPABASE_SERVICE_ROLE_KEY=

# Port the API listens on
PORT=8787

# Comma-separated list of allowed frontend origins (CORS).
# In dev: http://localhost:3030  ·  In prod: your deployed frontend URL.
FRONTEND_ORIGIN=http://localhost:3030
